# =============================================================================
# infra/terraform.auto.tfvars.example
#
# WireGuard VPN configuration
#
# Copy this to terraform.auto.tfvars and fill in your values.
# terraform.auto.tfvars is gitignored — never commit it.
# Store securely (password manager, encrypted file, etc.)
# =============================================================================

# Get from: console.hetzner.cloud → your project → Security → API Tokens
hcloud_token = "....."

# Your SSH public key — paste the full contents of ~/.ssh/id_ed25519.pub
ssh_public_key = "ssh-ed25519 AAAA... you@yourmachine"

# Your name — shows up as a label on the server
owner_tag = "your-gh-userid"

# WireGuard admin panel password (plaintext; will be bcrypt-hashed in cloud-init)
# Choose a strong password — this protects the admin UI
wg_admin_password = "choose-a-strong-password-here"

# Uncomment to change from defaults:
# vm_name          = "wireguard-vpn"
# server_type      = "cpx21"       # 2 vCPU shared, 4GB RAM, ~$5-10/mo
# location         = "ash"         # ash=Ashburn VA, hil=Hillsboro OR, nbg1=Nuremberg, fsn1=Falkenstein
# use_reserved_ip  = true          # Allocate a stable public IPv4 (recommended for VPN endpoint)
# wg_server_port   = 51820         # WireGuard UDP port (standard is 51820)
