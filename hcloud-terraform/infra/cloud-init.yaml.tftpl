#cloud-config
# =============================================================================
# infra/cloud-init.yaml.tftpl
#
# WireGuard VPN server provisioning via wg-easy (Docker container).
# Sets up persistent storage, generates admin peer config, and enables admin UI.
# =============================================================================

package_update: true
package_upgrade: true

apt:
  conf: |
    Dpkg::Options { "--force-confdef"; "--force-confold"; };
    APT::Get::Assume-Yes "true";

packages:
  - curl
  - jq
  - tmux
  - ufw
  - fail2ban
  - whois
  - wireguard-tools
  - docker.io
  - docker-compose

write_files:
  # SSH hardening
  - path: /etc/ssh/sshd_config.d/99-hardening.conf
    content: |
      PermitRootLogin prohibit-password
      PasswordAuthentication no
      X11Forwarding no
      MaxAuthTries 3

  # Main provisioning script
  - path: /root/provision-wireguard.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      export WG_DIR="/mnt/persist/wireguard"
      export WG_PORT="${wg_server_port}"
      export DOCKER_CONFIG_DIR="/root/.docker"

      echo ">>> [$(date +%T)] Starting WireGuard provisioning..."

      # Wait for persistent volume
      echo ">>> [$(date +%T)] Waiting for persistent volume..."
      for attempt in {1..90}; do
        if mountpoint -q /mnt/persist 2>/dev/null; then
          echo ">>> [$(date +%T)] Volume mounted at /mnt/persist"
          break
        fi
        for d in /mnt/HC_Volume_*; do
          if [ -d "$d" ] && mountpoint -q "$d" 2>/dev/null; then
            ln -sfn "$d" /mnt/persist
            echo ">>> [$(date +%T)] Symlinked $d -> /mnt/persist"
            break 2
          fi
        done
        echo ">>> [$(date +%T)] Waiting for volume ($attempt/90)..."
        sleep 5
      done

      # Start Docker
      systemctl start docker 2>/dev/null || true
      systemctl enable docker

      # Create WireGuard directories
      mkdir -p $WG_DIR/{config,admin,logs}
      echo ">>> [$(date +%T)] Created WireGuard directories"

      # Get server IP before configuring wg-easy
      echo ">>> [$(date +%T)] Fetching server public IP..."
      SERVER_IP=""
      for attempt in {1..5}; do
        SERVER_IP=$(curl -s http://checkip.amazonaws.com 2>/dev/null | tr -d '\n' || \
                    curl -s http://icanhazip.com 2>/dev/null | tr -d '\n' || \
                    curl -s http://ifconfig.me 2>/dev/null | tr -d '\n' || \
                    echo "")
        if [ -n "$SERVER_IP" ]; then
          echo ">>> [$(date +%T)] Server IP: $SERVER_IP"
          break
        fi
        sleep 2
      done

      # Export for envsubst
      export SERVER_IP

      # Create .env file with all wg-easy environment variables
      cd $WG_DIR
      cat > .env << 'ENVEOF'
      LANG=en
      WG_HOST=__SERVER_IP__
      WG_PORT=__WG_PORT__
      WG_MTU=1420
      WG_PERSISTENT_KEEPALIVE=25
      WG_DEFAULT_DNS=1.1.1.1,8.8.8.8
      WG_ALLOWED_IPS=10.0.0.0/24
      UI_LISTEN_PORT=51821
      PASSWORD_HASH=${wg_admin_password_hash}
      ENVEOF
      # Substitute only runtime variables (PASSWORD_HASH is already set by terraform)
      sed -i "s|__SERVER_IP__|$SERVER_IP|g" .env
      sed -i "s|__WG_PORT__|$WG_PORT|g" .env

      # Validate .env file
      if ! grep -q "^WG_HOST=[0-9]" .env; then
        echo "ERROR: WG_HOST not set correctly in .env"
        cat .env
        exit 1
      fi

      echo ">>> [$(date +%T)] Created .env with WG_HOST=$SERVER_IP"

      # Create docker-compose.yml (all env vars loaded from .env)
      cat > docker-compose.yml << 'DCEOF'
      version: '3.8'
      services:
        wg-easy:
          image: ghcr.io/wg-easy/wg-easy:latest
          container_name: wg-easy
          restart: unless-stopped
          cap_add:
            - NET_ADMIN
            - SYS_MODULE
          sysctls:
            - net.ipv4.ip_forward=1
            - net.ipv4.conf.all.src_valid_mark=1
          env_file: .env
          volumes:
            - ./config:/etc/wireguard
            - ./logs:/var/log/wg-easy
          ports:
            - "127.0.0.1:51821:51821/tcp"
            - "$${WG_PORT}:$${WG_PORT}/udp"
      DCEOF

      echo ">>> [$(date +%T)] Created docker-compose.yml"

      # Start wg-easy
      echo ">>> [$(date +%T)] Starting wg-easy container..."
      docker-compose up -d

      # Wait for initialization
      echo ">>> [$(date +%T)] Waiting for wg-easy initialization..."
      for attempt in {1..30}; do
        if [ -f "config/wg0.json" ]; then
          echo ">>> [$(date +%T)] wg0.json created"
          break
        fi
        sleep 2
      done

      sleep 5

      # Extract server public key from wg0.json
      echo ">>> [$(date +%T)] Extracting server public key..."
      SERVER_PUBKEY=""
      for attempt in {1..5}; do
        if [ -f "config/wg0.json" ]; then
          SERVER_PUBKEY=$(jq -r '.server.publicKey' config/wg0.json 2>/dev/null)
          if [ -n "$SERVER_PUBKEY" ] && [ "$SERVER_PUBKEY" != "null" ]; then
            echo ">>> [$(date +%T)] Got server public key: $SERVER_PUBKEY"
            break
          fi
        fi
        sleep 2
      done

      # Generate admin peer config
      echo ">>> [$(date +%T)] Generating admin peer config..."
      ADMIN_PRIVKEY=$(wg genkey)

      mkdir -p admin
      cat > admin/wg0.conf << CONFEOF
      [Interface]
      PrivateKey = $ADMIN_PRIVKEY
      Address = 10.0.0.2/32
      DNS = 1.1.1.1,8.8.8.8

      [Peer]
      PublicKey = $SERVER_PUBKEY
      Endpoint = $SERVER_IP:$WG_PORT
      AllowedIPs = 10.0.0.0/24
      PersistentKeepalive = 25
      CONFEOF

      chmod 600 admin/wg0.conf
      cp admin/wg0.conf /root/wireguard-admin.conf
      chmod 600 /root/wireguard-admin.conf

      echo ">>> [$(date +%T)] WireGuard setup complete!"
      echo ">>> [$(date +%T)] Hub: 10.0.0.1 | Admin: 10.0.0.2 | Endpoint: $SERVER_IP:$WG_PORT"

  # Shell setup
  - path: /root/provision-shell.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail

      # tmux config
      if [[ ! -f /root/.tmux.conf ]]; then
        echo ">>> Writing ~/.tmux.conf"
        cat > /root/.tmux.conf << 'TMUXEOF'
      set -g history-limit 50000
      set -g mouse on
      set -g set-clipboard on
      set -g base-index 1
      setw -g pane-base-index 1
      set -g status-interval 5
      set -g status-left "#[fg=green][#S] "
      set -g status-right "#[fg=yellow]%H:%M %d-%b"
      bind | split-window -h -c "#{pane_current_path}"
      bind - split-window -v -c "#{pane_current_path}"
      bind h select-pane -L
      bind j select-pane -D
      bind k select-pane -U
      bind l select-pane -R
      bind r source-file ~/.tmux.conf \; display "Config reloaded!"
      TMUXEOF
      fi

      # Shell aliases
      if ! grep -q "# wireguard-helpers" /root/.bashrc 2>/dev/null; then
        echo ">>> Adding WireGuard helpers to ~/.bashrc"
        cat >> /root/.bashrc << 'BASHEOF'

      # wireguard-helpers
      alias work="tmux attach -t work 2>/dev/null || tmux new -s work"
      alias ll="ls -lah"
      alias wg-logs="docker logs -f wg-easy"
      alias wg-restart="docker restart wg-easy"
      alias wg-status="docker ps -a | grep wg-easy"
      BASHEOF
      fi

      echo ">>> Shell setup complete"

runcmd:
  - export DEBIAN_FRONTEND=noninteractive
  - export NEEDRESTART_MODE=a

  # System hardening
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 22/tcp
  - ufw allow ${wg_server_port}/udp
  - ufw allow 51821/tcp
  - ufw --force enable
  - systemctl restart ssh
  - systemctl enable fail2ban
  - systemctl start fail2ban

  # WireGuard provisioning
  - /root/provision-wireguard.sh

  # Shell setup
  - /root/provision-shell.sh

final_message: |
  Cloud-init complete. WireGuard server is running.

  Next steps:
  1. Access admin UI:
     ssh -L 127.0.0.1:51821:127.0.0.1:51821 root@<server-ip>
     Then open http://127.0.0.1:51821

  2. Download admin client config:
     scp root@<server-ip>:/root/wireguard-admin.conf ./

  3. Import the .conf into your WireGuard client and connect!
